# GEMINI_API_KEY: Required for Gemini AI API calls (Vision, Live API, TTS, STT, Assistant).
# Keep strictly server-side (Node / Netlify Functions); never expose in frontend env vars.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ADDIS_AI_API_KEY: Optional Addis AI API key for Ethiopian language TTS voices (Amharic, Afaan Oromo, Tigrinya).
ADDIS_AI_API_KEY=""

# VITE_BACKEND_URL: Optional external Node/WebSocket backend origin when hosting frontend on Netlify
# and streaming Gemini Live WebSockets on a separate Node service (e.g. https://api.example.com).
VITE_BACKEND_URL=""

# ALLOWED_ORIGIN: Optional CORS origin when serving split frontend + backend deployments.
ALLOWED_ORIGIN="*"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

